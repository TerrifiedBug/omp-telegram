{
  "name": "omp-telegram",
  "version": "0.14.0",
  "description": "Standalone Telegram bridge, session topics, and herdr control plane for omp",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerrifiedBug/omp-telegram.git"
  },
  "homepage": "https://github.com/TerrifiedBug/omp-telegram#readme",
  "bugs": {
    "url": "https://github.com/TerrifiedBug/omp-telegram/issues"
  },
  "keywords": [
    "omp",
    "telegram",
    "herdr",
    "coding-agent",
    "telegram-bot"
  ],
  "files": [
    "src",
    "README.md",
    "SECURITY.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test",
    "check:host": "bun scripts/host-compat.ts",
    "smoke:package": "bun scripts/package-smoke.ts"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^18.1.16",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "overrides": {
    "@opentelemetry/core": "2.8.0"
  }
}
